{
  "name": "reliefmesh",
  "version": "0.1.0",
  "private": true,
  "description": "ReliefMesh — disaster-management and emergency-response coordination platform",
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "mobile:analyze": "cd mobile && flutter analyze",
    "mobile:test": "cd mobile && flutter test",
    "mobile:verify": "npm run mobile:analyze && npm run mobile:test",
    "mobile:build:android": "cd mobile && flutter build apk --release --dart-define=API_BASE_URL=https://reliefmesh-theta.vercel.app",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run mobile:verify && npm run build",
    "smoke": "node scripts/smoke-app.mjs",
    "verify:ci": "npm run verify && npm run smoke",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "5.19.1",
    "bcryptjs": "2.4.3",
    "clsx": "2.1.1",
    "firebase-admin": "^13.10.0",
    "jose": "5.9.3",
    "leaflet": "1.9.4",
    "lucide-react": "0.445.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "4.2.1",
    "recharts": "2.12.7",
    "tailwind-merge": "2.5.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "1.47.2",
    "@types/bcryptjs": "2.4.6",
    "@types/leaflet": "1.9.12",
    "@types/node": "20.16.5",
    "@types/react": "18.3.9",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "8.4.47",
    "prisma": "5.19.1",
    "tailwindcss": "3.4.12",
    "tsx": "4.19.1",
    "typescript": "5.6.2",
    "vitest": "2.1.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
