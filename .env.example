# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://reliefmesh:reliefmesh@localhost:5432/reliefmesh?schema=public"

# Secret used to sign session/auth tokens (generate with: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"

# Shared secret that simulated/future Guardian SOS devices must present
GUARDIAN_DEVICE_API_SECRET="replace-with-a-long-random-string"

# Optional active admin/operator account that owns incidents created by the
# shared-secret Guardian device endpoint. If omitted, the oldest active
# admin/operator account is used.
GUARDIAN_REPORTER_EMAIL="admin@reliefmesh.test"

# Base URL of the app (used for links in notifications, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
